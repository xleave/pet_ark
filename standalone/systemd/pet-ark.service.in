[Unit]
Description=Pet Ark native Wayland desktop pet
Documentation=https://github.com/xleave/pet_ark
After=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
EnvironmentFile=-%h/.config/pet-ark/runtime.env
ExecStart=@PET_ARK_LAUNCHER@
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=5s
SyslogIdentifier=pet-ark

[Install]
WantedBy=default.target
